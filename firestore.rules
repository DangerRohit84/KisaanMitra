rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Day1 hackathon rules: any signed-in user can read/write own scoped docs.
    // Harden before pilot: per-user ownership checks + FPO role claims.
    // TODO(pilot): replace with owner checks, e.g.
    //   allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
    //   + custom claims for FPO staff (e.g. request.auth.token.fpo == resource.data.fpoId).
    // Keep Day1 open-auth for hackathon judging; do NOT pilot with current rules.
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /farms/{farmId} {
      allow read, write: if request.auth != null;
    }
    match /diagnoses/{diagId} {
      allow read, write: if request.auth != null;
    }
    match /mandiCache/{doc} {
      allow read: if request.auth != null;
      allow write: if false; // server-only via Admin SDK
    }
    match /smsLog/{msgId} {
      allow read, write: if request.auth != null;
    }
  }
}
