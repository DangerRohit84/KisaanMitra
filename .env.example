# Copy to backend/.env and frontend/.env (frontend vars must start with VITE_)
# NEVER commit real keys — backend/.env + frontend/.env are gitignored.
# Real-first policy: leave MOCK_MODE=false (or unset) when keys present; mock fallback is automatic + labelled.

# --- Gemini via AI Studio (no GCP needed for MVP) ---
# Free signup: https://aistudio.google.com → Get API key (free tier, no credit card for MVP).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Set MOCK_MODE=true to run fully offline/demo without keys (default true if no key).
# With keys present keep MOCK_MODE=false for live Gemini vision/text (mock fallback stays labelled).
MOCK_MODE=false
# Opt-in Genkit flow (needs genkit + @genkit-ai/googleai + GOOGLE_GENAI_API_KEY or GEMINI_API_KEY).
ENABLE_GENKIT=false

# --- Weather: Open-Meteo FREE first (no key, no signup) + OpenWeather optional ---
# Open-Meteo (default, live, no key): https://open-meteo.com — free, no signup, CC-BY 4.0.
#   Backend tries https://api.open-meteo.com/v1/forecast?latitude=&longitude=&current_weather=true&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&timezone=Asia/Kolkata first (source open-meteo-live).
# OpenWeather (optional enrichment: humidity + place names, cached 1h server-side):
#   Free signup: https://openweathermap.org/api → free tier 60 calls/min, 1M calls/month.
OPENWEATHER_API_KEY=
# Default farm location (Indore, MP - pilot region)
DEFAULT_LAT=22.7196
DEFAULT_LON=75.8577

# --- Agmarknet / data.gov.in (live mandi prices; else static CSV + stale warning) ---
# Free signup: https://data.gov.in → Login/Signup → My Account → API Key (free, no card).
#   Resource: Agmarknet prices (e.g. 9ef84268-d588-465a-a308-a864a43d0070). Key goes in AGMARKNET_KEY below.
AGMARKNET_KEY=
# Optional override if resource id rotates:
# AGMARKNET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# --- Places: Overpass FREE first (no key) + Google Maps optional ---
# Overpass/OSM (default, live, no key): https://overpass-api.de/api/interpreter + https://www.openstreetmap.org/copyright
#   Backend POSTs shop=agrarian/amenity=marketplace around lat/lon 10km with User-Agent KisaanMitra/1.0 (source overpass-live).
# Google Maps (optional, better ranking/photos; needs billing):
#   Free credit signup: https://console.cloud.google.com/google/maps-apis ($200/mo free, card required).
#   Restrict key to HTTP referrers in Cloud Console.
# Frontend: VITE_MAPS_API_KEY, Backend proxy optional: MAPS_API_KEY (same key, Places Nearby Search)
VITE_MAPS_API_KEY=
MAPS_API_KEY=

# --- SMS (MSG91 or Twilio live; else in-memory log + queued:true) ---
# Free/trial signups (India DLT template mandatory for all):
#   MSG91 trial: https://msg91.com/signup (free trial credits + DLT route 4; sender KISAAN).
#   Fast2SMS trial: https://www.fast2sms.com (free trial credits, quick DLT; use via MSG91-compatible route or mock-log for MVP).
#   Twilio trial: https://www.twilio.com/try-twilio (free trial credit, test number; SMS_PROVIDER=twilio).
SMS_PROVIDER=
# msg91 | twilio | (empty = mock-log)
SMS_KEY=
# MSG91 extras:
# SMS_SENDER=KISAAN
# SMS_DLT_TEMPLATE_ID=
# Twilio extras (SMS_KEY = AuthToken):
# TWILIO_ACCOUNT_SID=
# TWILIO_FROM=+91XXXXXXXXXX

# --- Firebase (Web config for frontend) ---
# Free signup: https://console.firebase.google.com → Create project (Spark free tier, no card for Auth/Firestore/Hosting MVP).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Admin (backend, optional - falls back to in-memory + persist:false) ---
# Either set GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
# or FIREBASE_PROJECT_ID + Firestore in Datastore mode will use ADC on Cloud Run
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Server ---
PORT=8080
FRONTEND_DIST=../frontend/dist
# Prod: comma-separated allowed origins, e.g. CORS_ORIGIN=https://<hosting-domain>,https://<run-domain>
# CORS_ORIGIN=
